    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nif (res.statusCode !== 200) {\n  throw new Error('Shoraka login failed: HTTP ' + res.statusCode + ' ' + JSON.stringify(res.body).slice(0, 400));\n}\nconst raw = res.headers?.['set-cookie'] || [];\nconst cookies = (Array.isArray(raw) ? raw : [raw]).map(c => c.split(';')[0]);\nconst get = name => {\n  const hit = cookies.find(c => c.startsWith(name + '='));\n  return hit ? decodeURIComponent(hit.split('=').slice(1).join('=')) : null;\n};\nconst b = res.body || {};\nconst token = get('auth-token') || b.token || b.data?.token || b.auth_token || b.data?.auth_token || null;\nif (!token && !cookies.length) {\n  throw new Error('No token and no cookies in login response. body: ' + JSON.stringify(b).slice(0, 400));\n}\nreturn [{ json: { token, cookie: cookies.join('; ') } }];"
      },
