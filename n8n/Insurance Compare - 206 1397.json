      "id": "6a2779c2-dfda-4d02-a462-532fbc67c103",
      "name": "Get Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        656,
        1136
      ],
      "notes": "TODO: آدرس لیست شرکت‌ها و پارامترهای سناریو (پژو ۲۰۶ تیپ ۲، مدل ۱۳۹۷، ثالث). اگر سایت POST می‌خواهد، متد و بدنه را تغییر بده. اگر Authorization لازم نیست آن هدر را حذف کن.",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// نگاشت نام فارسی شرکت -> company_key (همان slugهای شوراکا)\nconst FA = {novin:'نوین',razi:'رازی',hekmat:'حکمت صبا',sina:'سینا',moalem:'معلم',mihan:'میهن',kowsar:'کوثر',pardis:'پردیس',dana:'دانا',alborz:'البرز',iran:'ایران',asia:'آسیا',ma:'ما',saman:'سامان',day:'دی',parsian:'پارسیان',pasargad:'پاسارگاد',karafarin:'کارآفرین',melat:'ملت',hafez:'حافظ',omid:'امید',taavon:'تعاون',sarmad:'سرمد',arman:'آرمان',hoshmand:'هوشمند',tejaratno:'تجارت نو'};\nconst norm = s => String(s == null ? '' : s)\n  .replace(/ي/g, 'ی').replace(/ك/g, 'ک').replace(/\\u200c/g, ' ')\n  .replace(/^\\s*(شرکت\\s+)?بیمه\\s+/, '').replace(/\\s+/g, ' ').trim();\nconst NAME_TO_KEY = {};\nfor (const [k, n] of Object.entries(FA)) NAME_TO_KEY[norm(n)] = k;\n\nconst SITE = 'site1';\nconst COVERAGE = 'third';\nconst now = new Date().toISOString();\n\nlet raw = $input.first().json;\n// اگر پاسخ داخل رشته‌ی JSON است (مثل فیلد data در شوراکا)\nif (typeof raw.data === 'string') { try { raw = JSON.parse(raw.data); } catch (e) {} }\n\n// TODO: مسیر آرایه‌ی شرکت‌ها در پاسخ\nconst list = Array.isArray(raw) ? raw : (raw.value || raw.data || []);\nif (!Array.isArray(list) || list.length === 0) {\n  throw new Error('Normalize: company list is empty or not found. Check the path.');\n}\n\nconst companies = [];\nconst commission = [];\nconst unmapped = [];\nconst seen = new Set();\n\nfor (const it of list) {\n  // TODO: نام فیلدها را با پاسخ واقعی تطبیق بده\n  const name = it.companyName;\n  const rawRate = it.cashCommissionPercent; // کمیسیون نقدی (اقساطی فعلاً نادیده)\n\n  const idKey = String(it.id || '').toLowerCase();\n  const ALIAS = { kosar: 'kowsar', moallem: 'moalem' };\n  const key = NAME_TO_KEY[norm(name)] || (FA[idKey] ? idKey : ALIAS[idKey]);\n  if (!key) { unmapped.push(name); continue; }\n  if (seen.has(key)) continue;\n  seen.add(key);\n\n  let rate = (rawRate === null || rawRate === undefined || rawRate === '') ? null : Number(rawRate);\n  if (rate !== null && !Number.isFinite(rate)) rate = null;\n  // کمیسیون صفر باید 0 بماند (در داشبورد «۰٪» نشان داده می‌شود)\n\n  companies.push({ site: SITE, company_key: key, name: String(name), status: 'ok' });\n  commission.push({ site: SITE, company_key: key, coverage: COVERAGE, vehicle: '206_1397', rate, captured_at: now });\n}\n\nreturn [{ json: { site: SITE, coverage: COVERAGE, captured_at: now, companies, commission, unmapped } }];"
      },
