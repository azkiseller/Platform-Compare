    {
      "parameters": {
        "method": "POST",
        "url": "https://coreapi.bimeh.com/v1/insurance/third-party/inquiry",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "accept",
