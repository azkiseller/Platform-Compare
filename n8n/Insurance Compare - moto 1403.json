        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const q = { MotorTypeId:7, ProductionYearId:2024, PreviousInsuranceStatusId:1, isRenewal:false, DurationId:2, coverages:188 };\n  const url = 'https://plusbimeh.com/thirdpartyMotor/planlist?' + Object.entries(q).map(([k,v]) => k + '=' + v).join('&');\n  return JSON.stringify({ ...q, InquiryUrl: url });\n})() }}",
        "options": {}
