    {
      "parameters": {
        "jsCode": "// استخراج کوکی نشست (و توکن، اگر در بدنه یا کوکی باشد)\nconst res = $input.first().json;\nconst sc = (res.headers && (res.headers['set-cookie'] || res.headers['Set-Cookie'])) || [];\nconst arr = Array.isArray(sc) ? sc : [sc];\nconst cookies = arr.filter(Boolean).map(c => c.split(';')[0]);\nconst cookie = cookies.join('; ');\n\n// TODO: اگر توکن در بدنه‌ی پاسخ است، مسیرش را اینجا بگذار\nlet token = null;\nif (res.body && typeof res.body === 'object') {\n  token = (res.body.value && res.body.value.token) || res.body.token || null;\n}\n// TODO: اگر توکن داخل کوکی است (مثل auth-token در شوراکا) نامش را بگذار\nconst tokenCookieName = 'securityToken';\nif (!token) {\n  const hit = cookies.find(c => c.startsWith(tokenCookieName + '='));\n  if (hit) token = hit.split('=').slice(1).join('=');\n}\n\nif (!cookie && !token) {\n  throw new Error('Login: no cookie or token found. Check the login response.');\n}\nreturn [{ json: { cookie, token } }];"
      },
