    {
      "parameters": {
        "jsCode": "const COVERAGE = 70000000;\nlet body = $input.first().json;\n// پاسخ ممکن است داخل فیلد data به صورت رشته آمده باشد\nif (typeof body.data === 'string') {\n  try { body = JSON.parse(body.data); }\n  catch (e) { throw new Error('Offers response is not valid JSON: ' + body.data.slice(0, 200)); }\n}\nif (body.status && body.status !== 'ok') {\n  throw new Error('Shoraka offers status: ' + body.status + ' ' + (body.message || ''));\n}\nconst offers = body.data?.offers ?? [];\nif (!offers.length) throw new Error('Shoraka offers list is empty');\nconst captured_at = new Date().toISOString();\nconst r2 = n => Math.round(Number(n || 0) * 100) / 100;\nreturn offers.map(o => {\n  const tariff = (o.tariffs || []).find(t => Number(t.financial_coverage) === COVERAGE) || o.tariffs?.[0];\n  // عددی که خود سایت به عنوان کارمزد نشان می‌دهد\n  const rate = r2(tariff?.total_discount_percent);\n  return { json: {\n    site: 'site2',\n    vehicle: '206_1397',\n    company_key: o.company_url_name,\n    company_name: o.company_name,\n    coverage: 'third',\n    rate,\n    rate_fixed: r2(o.commissions?.fixed),\n    rate_shoraka: r2(o.commissions?.shoraka),\n    premium: tariff?.tariff ?? null,\n    status: tariff ? 'ok' : 'off',\n    captured_at\n  } };\n});"
      },
