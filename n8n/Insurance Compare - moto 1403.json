      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        656,
        1328
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "notes": "ثالث موتور: تک‌سیلندر، ۱۴۰۳، بدون بیمه‌نامه‌ی قبلی، یک‌ساله، ۷۰ میلیون",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const COVERAGE = 70000000;\nlet body = $input.first().json;\n// پاسخ ممکن است داخل فیلد data به صورت رشته آمده باشد\nif (typeof body.data === 'string') {\n  try { body = JSON.parse(body.data); }\n  catch (e) { throw new Error('Offers response is not valid JSON: ' + body.data.slice(0, 200)); }\n}\nif (body.status && body.status !== 'ok') {\n  throw new Error('Shoraka motor offers status: ' + body.status + ' ' + (body.message || ''));\n}\nconst offers = body.data?.offers ?? [];\nif (!offers.length) throw new Error('Shoraka motor offers list is empty');\nconst captured_at = new Date().toISOString();\nconst r2 = n => (n == null || n === '' || !Number.isFinite(Number(n))) ? null : Math.round(Number(n) * 100) / 100;\nreturn offers.map(o => {\n  const tariff = (o.tariffs || []).find(t => Number(t.financial_coverage) === COVERAGE) || o.tariffs?.[0];\n  // عددی که خود سایت به عنوان کارمزد نشان می‌دهد\n  const rate = r2(tariff?.total_discount_percent);\n  return { json: {\n    site: 'site2',\n    vehicle: 'moto_1403',\n    company_key: o.company_url_name,\n    company_name: o.company_name,\n    coverage: 'third',\n    rate,\n    rate_fixed: r2(o.commissions?.fixed),\n    rate_shoraka: r2(o.commissions?.shoraka),\n    premium: tariff?.tariff ?? null,\n    status: tariff ? 'ok' : 'off',\n    captured_at\n  } };\n});"
      },
      "id": "4c0a6dab-dbb3-4710-8c53-71b22226a2d6",
      "name": "Normalize Site2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        1328
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst seen = new Set();\nconst companies = [], commissions = [];\nfor (const i of items) {\n  if (!i.company_key) continue;\n  const k = i.site + '|' + i.company_key;\n  if (seen.has(k)) continue;\n  seen.add(k);\n  companies.push({ site: i.site, company_key: i.company_key, name: i.company_name, status: i.status, updated_at: i.captured_at });\n  if (i.status === 'ok') commissions.push({ site: i.site, company_key: i.company_key, coverage: i.coverage, vehicle: i.vehicle, rate: i.rate, captured_at: i.captured_at });\n}\nreturn [{ json: { companies, commissions } }];"
      },
