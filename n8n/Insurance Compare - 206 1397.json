              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const d = new Date().toISOString().slice(0, 10); // امروز، چون سایت تاریخ انقضای بیمه‌نامه‌ی قبلی را می‌خواهد\n  const q = { UsingTypeId:1, VehicleCategoryId:1, BrandId:1001, ModelId:1030, ProductionYearId:2018, PreviousInsuranceStatusId:2, PreviousCompanyId:1026, PreviousExpirationDate:d, PreviousDurationId:1, ThirdPartyDiscountId:0, DriverDiscountId:0, Damage:false, ownershipChange:false, isRenewal:false, DurationId:2, coverages:188 };\n  const url = 'https://plusbimeh.com/thirdparty/planlist?' + Object.entries(q).map(([k,v]) => k + '=' + v).join('&');\n  return JSON.stringify({ ...q, InquiryUrl: url });\n})() }}",
        "options": {}
      },
      "id": "a10a720e-0898-44a2-bb65-e583ea912242",
      "name": "Inquiry Site3",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        848
      ],
      "notesInFlow": true,
      "notes": "سناریوی ثابت: پژو ۲۰۶ تیپ ۲، ۱۳۹۷، ثالث؛ تاریخ بیمه‌نامه‌ی قبلی هر بار برابر امروز",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const COVERAGE_ID = 188;   // پوشش مالی ۷۰ میلیون تومان (همان سناریوی شوراکا)\nconst DURATION_ID = 2;     // یک ساله\n\n// شناسه‌ی شرکت در سایت سوم ← همان company_key که در شوراکا/ازکی استفاده می‌شود\nconst KEYS = {\n  1019: 'day', 1020: 'moalem', 1021: 'saman', 1023: 'parsian', 1024: 'asia', 1025: 'razi', 1026: 'iran',\n  1027: 'sarmad', 1028: 'taavon', 1029: 'dana', 1030: 'mihan', 1031: 'arman', 1032: 'sina', 1033: 'novin',\n  1034: 'alborz', 1038: 'kowsar', 1039: 'tejaratno', 1060: 'hekmat', 1066: 'pardis', 1067: 'hoshmand'\n};\n\nlet body = $input.first().json;\nif (Array.isArray(body)) body = body[0];\nconst inquiries = body?.Inquiries ?? [];\nconst companies = body?.Companies ?? [];\nif (!inquiries.length) throw new Error('Site3: Inquiries list is empty');\n\nconst cov = (body.Coverages || []).find(c => c.Id === COVERAGE_ID);\nif (!cov) throw new Error('Site3: coverage ' + COVERAGE_ID + ' not found in response');\n\nconst names = {};\ncompanies.forEach(c => { names[c.Id] = String(c.Title || '').trim(); });\n\nconst captured_at = new Date().toISOString();\nconst r2 = n => Math.round(Number(n || 0) * 100) / 100;\n// «۱۴%» یا «14%» → ۱۴ ؛ خالی → null (یعنی سایت کارمزد نشان نداده، نه صفر)\nconst pct = h => {\n  if (h == null || h === '') return null;\n  const fa = '۰۱۲۳۴۵۶۷۸۹';\n  const s = String(h).replace(/[۰-۹]/g, d => fa.indexOf(d)).replace('٫', '.');\n  const m = s.match(/[\\d.]+/);\n  return m ? Number(m[0]) : null;\n};\n\nconst rows = inquiries.filter(x => x.Details?.CoverageId === COVERAGE_ID && x.DurationId === DURATION_ID);\nif (!rows.length) throw new Error('Site3: no rows for coverage/duration');\n\n// برای هر شرکت فقط یک ردیف\nconst seen = new Set();\nconst out = [];\nfor (const x of rows) {\n  const id = x.CompanyId;\n  if (seen.has(id)) continue;\n  seen.add(id);\n  const cp = x.CashPrice || {};\n  out.push({ json: {\n    site: 'site3',\n    vehicle: '206_1397',\n    company_key: KEYS[id] || ('c' + id),\n    company_name: names[id] || String(id),\n    coverage: 'third',\n    rate: pct(cp.Hint) == null ? null : r2(pct(cp.Hint)),\n    premium: cp.FinalAmount ?? null,\n    status: x.IsLocked ? 'off' : 'ok',\n    captured_at\n  } });\n}\nreturn out;\n"
      },
      "id": "a572e740-e27f-47e6-9654-20cb6650b618",
      "name": "Normalize Site3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        848
      ],
      "notesInFlow": true,
      "notes": "کارمزد = CashPrice.Hint (مثلاً «۱۴%»)؛ فقط پوشش ۱۸۸ (۷۰ میلیون) و یک‌ساله",
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst seen = new Set();\nconst companies = [];\nfor (const i of items) {\n  const k = i.site + '|' + i.company_key;\n  if (seen.has(k)) continue;\n  seen.add(k);\n  companies.push({ site: i.site, company_key: i.company_key, name: i.company_name, status: i.status, updated_at: i.captured_at });\n}\nconst commissions = items\n  .filter(i => i.status === 'ok')\n  .map(i => ({ site: i.site, company_key: i.company_key, coverage: i.coverage, vehicle: i.vehicle, rate: i.rate == null ? null : Number(i.rate), captured_at: i.captured_at }));\nreturn [{ json: { companies, commissions } }];\n"
      },
