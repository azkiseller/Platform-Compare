    {
      "parameters": {
        "jsCode": "// پاسخ: آرایه‌ای از شرکت‌ها. کارمزد نقدی‌ای که سایت نشان می‌دهد = سهم سلر + کمپین\nconst ALIAS = { tejarateno: 'tejaratno', kosar: 'kowsar', moallem: 'moalem', dey: 'day', mellat: 'melat', hekmatsaba: 'hekmat' };\nconst KNOWN = new Set(['novin','razi','hekmat','sina','moalem','mihan','kowsar','pardis','dana','alborz','iran','asia','ma','saman','day','parsian','pasargad','karafarin','melat','hafez','omid','taavon','sarmad','arman','hoshmand','tejaratno']);\nconst SITE = 'site1', COVERAGE = 'third', VEHICLE = 'moto_1403';\nconst now = new Date().toISOString();\n\nlet list = $input.first().json;\nif (!Array.isArray(list)) list = list.value || list.data || $input.all().map(i => i.json);\nif (!Array.isArray(list) || !list.length || !list[0].prices) throw new Error('Azki motor pricing: unexpected response');\n\nconst companies = [], commission = [], unmapped = [], seen = new Set();\nfor (const it of list) {\n  const raw = String(it.id || '').toLowerCase();\n  const key = ALIAS[raw] || raw;\n  if (!KNOWN.has(key)) { unmapped.push(it.id + ' ' + (it.title || '')); continue; }\n  if (seen.has(key)) continue;\n  seen.add(key);\n  const s = it.sellerCommissionPercent, c = it.campaignCommissionPercent;\n  const rate = (s == null && c == null) ? null : Number(s || 0) + Number(c || 0);\n  companies.push({ site: SITE, company_key: key, name: String(it.title || it.id).trim(), status: 'ok' });\n  commission.push({ site: SITE, company_key: key, coverage: COVERAGE, vehicle: VEHICLE, rate, captured_at: now });\n}\nreturn [{ json: { site: SITE, coverage: COVERAGE, captured_at: now, companies, commission, unmapped } }];"
      },
