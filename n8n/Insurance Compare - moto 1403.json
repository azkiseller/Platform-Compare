      "id": "901733af-813e-4889-949e-6b810a5c11f7",
      "name": "Inquiry Site3",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        848
      ],
      "notesInFlow": true,
      "notes": "موتور تک‌سیلندر (MotorTypeId=7)، ۱۴۰۳ (=2024)، فاقد بیمه‌نامه، یک‌ساله، پوشش ۱۸۸ = ۷۰ میلیون",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const COVERAGE_ID = 188;   // پوشش مالی ۷۰ میلیون تومان (همان سناریوی شوراکا)\nconst DURATION_ID = 2;     // یک ساله\n\n// شناسه‌ی شرکت در سایت سوم ← همان company_key که در شوراکا/ازکی استفاده می‌شود\nconst KEYS = {\n  1019: 'day', 1020: 'moalem', 1021: 'saman', 1023: 'parsian', 1024: 'asia', 1025: 'razi', 1026: 'iran',\n  1027: 'sarmad', 1028: 'taavon', 1029: 'dana', 1030: 'mihan', 1031: 'arman', 1032: 'sina', 1033: 'novin',\n  1034: 'alborz', 1038: 'kowsar', 1039: 'tejaratno', 1060: 'hekmat', 1066: 'pardis', 1067: 'hoshmand'\n};\n\nlet body = $input.first().json;\nif (Array.isArray(body)) body = body[0];\nconst inquiries = body?.Inquiries ?? [];\nconst companies = body?.Companies ?? [];\nif (!inquiries.length) throw new Error('Site3: Inquiries list is empty');\n\nconst cov = (body.Coverages || []).find(c => c.Id === COVERAGE_ID);\nif (!cov) throw new Error('Site3: coverage ' + COVERAGE_ID + ' not found in response');\n\nconst names = {};\ncompanies.forEach(c => { names[c.Id] = String(c.Title || '').trim(); });\n\nconst captured_at = new Date().toISOString();\nconst r2 = n => Math.round(Number(n || 0) * 100) / 100;\n// «۱۴%» یا «14%» → ۱۴ ؛ خالی → null (یعنی سایت کارمزد نشان نداده، نه صفر)\nconst pct = h => {\n  if (h == null || h === '') return null;\n  const fa = '۰۱۲۳۴۵۶۷۸۹';\n  const s = String(h).replace(/[۰-۹]/g, d => fa.indexOf(d)).replace('٫', '.');\n  const m = s.match(/[\\d.]+/);\n  return m ? Number(m[0]) : null;\n};\n\nconst rows = inquiries.filter(x => x.Details?.CoverageId === COVERAGE_ID && x.DurationId === DURATION_ID);\nif (!rows.length) throw new Error('Site3: no rows for coverage/duration');\n\n// برای هر شرکت فقط یک ردیف\nconst seen = new Set();\nconst out = [];\nfor (const x of rows) {\n  const id = x.CompanyId;\n  if (seen.has(id)) continue;\n  seen.add(id);\n  const cp = x.CashPrice || {};\n  out.push({ json: {\n    site: 'site3',\n    vehicle: 'moto_1403',\n    company_key: KEYS[id] || null,\n    unmapped: KEYS[id] ? undefined : id,\n    company_name: names[id] || String(id),\n    coverage: 'third',\n    rate: pct(cp.Hint) == null ? null : r2(pct(cp.Hint)),\n    premium: cp.FinalAmount ?? null,\n    status: x.IsLocked ? 'off' : 'ok',\n    captured_at\n  } });\n}\nreturn out;\n"
      },
      "id": "4aaa5064-d800-48b5-a55a-45165dba04fd",
      "name": "Normalize Site3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        848
      ],
      "notesInFlow": true,
      "notes": "کارمزد = CashPrice.Hint (مثلاً «۱۴%»)؛ فقط پوشش ۱۸۸ (۷۰ میلیون) و یک‌ساله",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// شرکت‌هایی که در نگاشت KEYS نیستند ذخیره نمی‌شوند (در Site3 Output با unmapped دیده می‌شوند)\nconst items = $input.all().map(i => i.json).filter(i => i.company_key);\nconst seen = new Set();\nconst companies = [];\nfor (const i of items) {\n  const k = i.site + '|' + i.company_key;\n  if (seen.has(k)) continue;\n  seen.add(k);\n  companies.push({ site: i.site, company_key: i.company_key, name: i.company_name, status: i.status, updated_at: i.captured_at });\n}\nconst commissions = items\n  .filter(i => i.status === 'ok')\n  .map(i => ({ site: i.site, company_key: i.company_key, coverage: i.coverage, vehicle: i.vehicle, rate: i.rate == null ? null : Number(i.rate), captured_at: i.captured_at }));\nreturn [{ json: { companies, commissions } }];\n"
      },
